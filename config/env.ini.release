# 环境模式：debug / release / test，取值非法时按 release 处理
env_mode = release

[server]
# 仅用于启动日志里拼出访问地址，不改变实际监听方式
protocol = http
# http 端口号
http_port = 8090
# 优雅退出的最长等待时间
shutdown_timeout = 10s

[websocket]
# 单个连接的读 / 写缓冲区大小（字节）
read_buffer_size = 1024
write_buffer_size = 1024
# 单条消息的最大字节数，超过会被拒绝
max_message_size = 4096
# 服务端向客户端发送 ping 的间隔，0 表示关闭心跳
ping_period = 30s
# 等待客户端 pong 的超时（同时作为读超时），0 表示不限制
pong_wait = 60s
# 单次写超时，0 表示不限制
write_wait = 10s
# 每个连接的待发送队列长度，队列满视为连接卡死
send_queue = 64
# 是否允许任意来源（跨站）连接；默认只允许同源
allow_all_origins = false
